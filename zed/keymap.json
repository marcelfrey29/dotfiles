// Zed Keybindings
//
// Documentation: https://zed.dev/docs/key-bindings
[
    // Global
    {
        "context": "Workspace",
        "bindings": {
            "f1": "file_finder::Toggle"
        }
    },
    // Left Dock
    {
        "context": "Workspace",
        "bindings": {
            "cmd-!": "workspace::ToggleLeftDock"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "cmd-b": "workspace::ToggleLeftDock"
        }
    },
    // Project Panel
    {
        "context": "Workspace",
        "bindings": {
            "cmd-1": "project_panel::ToggleFocus"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "cmd-shift-e": "project_panel::ToggleFocus"
        }
    },
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
            "cmd-shift-n": "project_panel::NewDirectory"
        }
    },
    {
        "context": "ProjectPanel",
        "bindings": {
            "shift-f6": "project_panel::Rename"
        }
    },
    // Git Panel
    {
        "context": "Workspace",
        "bindings": {
            "cmd-2": "git_panel::ToggleFocus"
        }
    },
    {
        "context": "GitPanel",
        "unbind": {
            "cmd-1": "git_panel::ActivateChangesTab"
        }
    },
    {
        "context": "GitPanel",
        "unbind": {
            "cmd-2": "git_panel::ActivateHistoryTab"
        }
    },
    // Right Dock
    {
        "context": "Workspace",
        "bindings": {
            "cmd-/": "workspace::ToggleRightDock"
        }
    },
    // Outline Panel
    {
        "context": "Workspace",
        "bindings": {
            "cmd-7": "outline_panel::ToggleFocus"
        }
    },
    // Terminal
    {
        "bindings": {
            "f12": "terminal_panel::ToggleFocus"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "shift-f12": "terminal_panel::Toggle"
        }
    },
    // Tools
    {
        "context": "Workspace",
        "bindings": {
            "cmd-3": "diagnostics::Deploy"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "cmd-shift-r": [
                "pane::DeploySearch",
                {
                    "replace_enabled": true
                }
            ]
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "cmd-shift-h": [
                "pane::DeploySearch",
                {
                    "replace_enabled": true
                }
            ]
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "cmd-r": [
                "buffer_search::Deploy",
                {
                    "replace_enabled": true
                }
            ]
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "cmd-r": "workspace::ToggleRightDock"
        }
    },
    // Tabs
    {
        "context": "Workspace",
        "bindings": {
            "cmd-shift-l": "tab_switcher::Toggle"
        }
    },
    {
        "context": "Workspace",
        "bindings": {
            "cmd-shift-h": [
                "tab_switcher::Toggle",
                {
                    "select_last": true
                }
            ]
        }
    },
    {
        "context": "Editor",
        "unbind": {
            "cmd-shift-l": "editor::SelectAllMatches"
        }
    },
    // Debugging

    // Editor
    {
        "context": "Editor",
        "bindings": {
            "alt-enter": "editor::ToggleCodeActions"
        }
    },
    {
        "context": "!menu",
        "bindings": {
            "cmd-Ü": "editor::Hover"
        }
    },
    {
        "context": "vim_mode == normal || vim_mode == visual || vim_mode == operator || vim_mode == insert",
        "bindings": {
            "cmd-shift-k": "editor::MoveLineUp"
        }
    },
    {
        "context": "vim_mode == normal || vim_mode == visual || vim_mode == operator || vim_mode == insert",
        "bindings": {
            "cmd-shift-j": "editor::MoveLineDown"
        }
    },
    {
        "context": "Editor",
        "unbind": {
            "cmd-shift-k": "editor::DeleteLine"
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "shift-f6": "editor::Rename"
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "cmd-d": "editor::DuplicateLineDown"
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "cmd-b": "editor::GoToDefinition"
        }
    },
    {
        "bindings": {
            "cmd-shift-b": "editor::GoToNextReference"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "cmd-shift-b": "outline_panel::ToggleFocus"
        }
    },
    {
        "context": "Editor",
        "bindings": {
            "cmd-shift-f7": "editor::FindAllReferences"
        }
    },
    // Search
    {
        "context": "BufferSearchBar",
        "bindings": {
            "shift-f3": "search::SelectPreviousMatch"
        }
    },
    {
        "context": "BufferSearchBar",
        "unbind": {
            "shift-enter": "search::SelectPreviousMatch"
        }
    },
    {
        "context": "Pane",
        "bindings": {
            "f3": "search::SelectNextMatch"
        }
    }
    // Other
]
